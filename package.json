{
  "name": "@userill/cli",
  "version": "0.1.0",
  "private": false,
  "description": "Rill CLI, pay-url, pay, connect, wallets, sellers, and fund links",
  "type": "module",
  "bin": {
    "rill": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rillongit/cli.git"
  },
  "homepage": "https://userill.com",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "smoke:pay": "tsx scripts/smoke-pay.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
